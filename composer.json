{
    "name": "waner1er/behind-the-mask",
    "description": "Vigilante – Behind the Mask : beat'em up d'arcade généré en PHP (pixel art, décors SVG) et animé en JavaScript.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.11",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Vigilante\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vigilante\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8000"
        ],
        "build": "php tools/build.php",
        "test": "phpunit",
        "lint": "phpcs",
        "analyse": "phpstan analyse",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
