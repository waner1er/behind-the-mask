<?xml version="1.0"?>
<ruleset name="Vigilante">
    <description>PSR-12, avec des lignes jusqu'à 160 caractères (palettes et sprites en pixel art).</description>
    <file>src</file>
    <file>tests</file>
    <file>config</file>
    <file>templates</file>
    <file>tools</file>
    <file>index.php</file>
    <file>scene.php</file>
    <file>bootstrap.php</file>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>
    <!-- les textes du scénario restent sur une ligne -->
    <rule ref="Generic.Files.LineLength.TooLong">
        <exclude-pattern>config/story.php</exclude-pattern>
    </rule>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="160"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
    <!-- les fichiers de config/ et les points d'entrée renvoient ou exécutent directement -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>config/*</exclude-pattern>
        <exclude-pattern>templates/*</exclude-pattern>
        <exclude-pattern>tools/*</exclude-pattern>
        <exclude-pattern>index.php</exclude-pattern>
        <exclude-pattern>scene.php</exclude-pattern>
        <exclude-pattern>bootstrap.php</exclude-pattern>
    </rule>
</ruleset>
